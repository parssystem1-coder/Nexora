# Copy to .env for local development. Never commit the real .env (see .gitignore).

# The app/runtime connection — nexora_app (NOSUPERUSER, NOBYPASSRLS, never a
# table owner). Used by platform/config.ts's loadDbConfig() and, by default,
# by the conformance harness's live-DB tests (loadConformanceTestDbConfig()).
# Matches docker-compose.yml's init script (platform/db/init/001_roles.sql).
DATABASE_URL=postgresql://nexora_app:nexora_app_dev_only@localhost:5433/nexora

# The migration/schema-owner connection — nexora_migrate. Only the migration
# runner (platform/db/migrate-cli.ts) and the harness's schema-structure
# checks use this; it is never the role the running app or its tests query
# through, because it owns the tables it creates and would bypass RLS.
MIGRATE_DATABASE_URL=postgresql://nexora_migrate:nexora_migrate_dev_only@localhost:5433/nexora

# Optional override: point the conformance harness's live-DB self-tests at a
# different server/role than DATABASE_URL. Rarely needed — defaults to
# DATABASE_URL (the nexora_app role) if unset.
# CONFORMANCE_TEST_DATABASE_URL=

# Matches docker-compose.yml's redis service (host port 6380). Commented
# out, unlike DATABASE_URL/MIGRATE_DATABASE_URL above: nothing in this
# codebase reads this yet (no client dependency, no BullMQ) — the service
# exists so the compose/CI plumbing is proven before Phase 2's first queue
# consumer needs it. See PHASE_1_DEBT_CLOSURE.md D-2 and DECISION_LOG.md
# 2026-08-29.
# REDIS_URL=redis://localhost:6380
