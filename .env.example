# Copy to .env for local development. Never commit the real .env (see .gitignore).

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://nexora:nexora_dev_only@localhost:5433/nexora

# Used only by the conformance harness's live-DB schema self-test
# (tools/conformance/harness.selftest.live-db.spec.ts). Points at the same
# server as DATABASE_URL; the tests isolate themselves in a dedicated schema
# and reset it between fixtures, so this does not need a separate database.
CONFORMANCE_TEST_DATABASE_URL=postgresql://nexora:nexora_dev_only@localhost:5433/nexora
